+use gba_core::Machine;
+
+pub(crate) const SIZE: (u32, u32) = (1920, 1080);
+
+type Render = unsafe extern "C" fn(
+    vram: *const u8,
+    oam: *const u8,
+    palette: *const u8,
+    io: *const u8,
+    backdrop: *const u16,
+    mode: u32,
+    pixels: *mut [u8; 4],
+) -> u32;
+
+pub(crate) struct WideVideo {
+    render: Render,
+    _library: libloading::Library,
+    pub(crate) pixels: Vec<[u8; 4]>,
+    active: bool,
+    last_serial: u32,
+    frame_count: u64,
+    pass_count: u64,
+    diagnostic: bool,
+    pause_layer: Vec<[u8; 4]>,
+    menu_x: [usize; 1620],
+    menu_y: [usize; 1080],
+}
+
+impl WideVideo {
+    pub(crate) fn configured() -> Option<Self> {
+        let path = std::env::var_os("VRALLY3_HD_RENDERER")?;
+        // The launcher supplies the same game-local library used by the CPU
+        // translation. Keeping a handle alive keeps the C render symbol valid.
+        let result = unsafe {
+            libloading::Library::new(&path).and_then(|library| {
+                let render = *library.get::<Render>(b"vrally3_render_frame\0")?;
+                Ok((library, render))
+            })
+        };
+        match result {
+            Ok((_library, render)) => Some(Self {
+                render,
+                _library,
+                pixels: vec![[0, 0, 0, 255]; (SIZE.0 * SIZE.1) as usize],
+                active: false,
+                last_serial: 0,
+                frame_count: 0,
+                pass_count: 0,
+                diagnostic: std::env::var_os("VRALLY3_VIDEO_LOG").is_some(),
+                pause_layer: Vec::new(),
+                menu_x: std::array::from_fn(|x| (2 * x + 1) * 240 / 3240),
+                menu_y: std::array::from_fn(|y| (2 * y + 1) * 160 / 2160),
+            }),
+            Err(e) => {
+                eprintln!("V3D: could not load wide video renderer: {e}");
+                None
+            }
+        }
+    }
+
+    pub(crate) fn render(&mut self, machine: &Machine) -> bool {
+        let m = &machine.bus;
+        // The game runtime owns all the input buffers. The render call reads
+        // these slices synchronously and writes exactly SIZE.0 * SIZE.1 pixels.
+        let serial = unsafe {
+            (self.render)(
+                m.vram.as_ptr(),
+                m.oam.as_ptr(),
+                m.palette.as_ptr(),
+                m.io.as_ptr(),
+                m.frame_backdrop.as_ptr(),
+                u32::from(m.frame_display_control),
+                self.pixels.as_mut_ptr(),
+            )
+        };
+        if serial == 0 {
+            if self.active {
+                eprintln!("V3D: 16:9 bitmap layout");
+            }
+            self.active = false;
+            return false;
+        }
+        if !self.active {
+            self.active = true;
+            eprintln!("V3D: live 1920x1080, 16:9");
+        }
+        self.frame_count += 1;
+        if serial != self.last_serial {
+            self.pass_count += 1;
+            self.last_serial = serial;
+        }
+        if self.diagnostic && self.frame_count % 120 == 0 {
+            eprintln!("V3D: {} frames displayed, {} scene updates", self.frame_count, self.pass_count);
+        }
+        true
+    }
+
+    // Place the outer groups at the sides and insert the extra space in two
+    // background gutters. For artwork without a clear gutter, extend its edge.
+    fn gutter(rgba: &[[u8; 4]], right: bool) -> usize {
+        let mut best = if right { 240 } else { 0 };
+        let mut best_score = 10_000;
+        for margin in 5usize..58 {
+            let x = if right { 240 - margin } else { margin };
+            let mut cost = 0;
+            for row in rgba.chunks_exact(240) {
+                let mut peak = 0;
+                for i in x-3..x+3 {
+                    for c in 0..3 {
+                        peak = peak.max(row[i-1][c].abs_diff(row[i][c]) as usize);
+                    }
+                }
+                cost += peak * peak.min(32);
+                if cost >= best_score { break; }
+            }
+            // Keep small margin changes in textured art from moving buttons.
+            cost += (margin.abs_diff(25)) * 5;
+            if cost < best_score {
+                best = x;
+                best_score = cost;
+            }
+        }
+        best
+    }
+
+    pub(crate) fn layout_2d(&mut self, rgba: &[[u8; 4]]) {
+        let left = Self::gutter(rgba, false);
+        let right = Self::gutter(rgba, true);
+        let left_hd = self.menu_x.partition_point(|&x| x < left);
+        let right_hd = self.menu_x.partition_point(|&x| x < right);
+        for (y, row) in self.pixels.chunks_exact_mut(SIZE.0 as usize).enumerate() {
+            let source = &rgba[self.menu_y[y] * 240..][..240];
+            for (start, end, offset) in [(0, left_hd, 0), (left_hd, right_hd, 150),
+                                         (right_hd, 1620, 300)] {
+                for (dst, &x) in row[start+offset..end+offset].iter_mut().zip(&self.menu_x[start..end]) {
+                    *dst = source[x];
+                }
+            }
+            for (split, start) in [(left, left_hd), (right, right_hd + 150)] {
+                let a = source[split.saturating_sub(1)];
+                let b = source[split.min(239)];
+                if a == b {
+                    row[start..start+150].fill(a);
+                } else {
+                    for (i, pixel) in row[start..start+150].iter_mut().enumerate() {
+                        *pixel = std::array::from_fn(|c|
+                            ((a[c] as usize * (150-i) + b[c] as usize * i) / 150) as u8);
+                    }
+                }
+            }
+        }
+    }
+
+    pub(crate) fn draw_pause(&mut self, menu: &menu::Menu, av: &input_config::AvConfig) {
+        self.pause_layer.resize(240 * 160, [0; 4]);
+        self.pause_layer.fill([0; 4]);
+        menu.draw(av, &mut self.pause_layer, 240, 160);
+        for (y, row) in self.pixels.chunks_exact_mut(SIZE.0 as usize).enumerate() {
+            let overlay = &self.pause_layer[self.menu_y[y] * 240..][..240];
+            for (x, pixel) in row.iter_mut().enumerate() {
+                if (150..1770).contains(&x) {
+                    let ink = overlay[self.menu_x[x-150]];
+                    if ink[3] != 0 {
+                        *pixel = ink;
+                        continue;
+                    }
+                }
+                for channel in &mut pixel[..3] {
+                    *channel = (*channel as u16 * 5 / 16) as u8;
+                }
+            }
+        }
+    }
+}
